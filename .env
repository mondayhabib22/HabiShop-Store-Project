# ── Local development ─────────────────────────────────────────────────
# Vite dev server proxies /api → localhost:5000 automatically.
# Leave VITE_API_URL commented out for local dev.
# VITE_API_URL=http://localhost:5000/api

# ── Production / Hosting ──────────────────────────────────────────────
# Set this to your deployed backend URL before running: npm run build
# Example (Render):  VITE_API_URL=https://habishop-api.onrender.com/api
# Example (Railway): VITE_API_URL=https://habishop-api.up.railway.app/api
# Example (VPS):     VITE_API_URL=https://api.yourdomain.com/api
VITE_API_URL=

# App name (optional)
VITE_APP_NAME=HabiShop

# Paystack public key (get from https://dashboard.paystack.com)
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Dev-only: override backend proxy target ───────────────────────────
# Only needed if your local backend runs on a port other than 5000
# VITE_BACKEND_URL=http://localhost:5000
